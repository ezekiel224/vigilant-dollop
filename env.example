# music-autodl — environment variable template
# Copy this to .env and fill in your values

# ── Tidarr ─────────────────────────────────────────────────────────────────
TIDARR_URL=http://localhost:8484
TIDARR_KEY=                        # from: docker exec tidarr cat /shared/.tidarr-api-key

# ── Plex ───────────────────────────────────────────────────────────────────
PLEX_URL=http://localhost:32400
PLEX_TOKEN=                        # leave blank to disable
PLEX_MUSIC_LIBRARY=Music

# ── Last.fm ────────────────────────────────────────────────────────────────
LASTFM_API_KEY=                    # https://www.last.fm/api/account/create
LASTFM_USERNAME=                   # leave blank to disable
LASTFM_PERIOD=1month               # overall | 7day | 1month | 3month | 6month | 12month
LASTFM_TOP_LIMIT=50

# ── Spotify ────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=                 # https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_SECRET=             # leave blank to disable
SPOTIFY_REDIRECT_URI=http://localhost:9090

# ── TIDAL ──────────────────────────────────────────────────────────────────
TIDAL_ENABLED=true                 # set false to disable
TIDAL_SESSION_FILE=/data/tidal_session.json

# ── Recommendation tuning ──────────────────────────────────────────────────
SIMILAR_PER_ARTIST=10              # similar artists to fetch per seed
MIN_SIMILARITY=0.3                 # Last.fm match threshold (0–1)
SKIP_EXISTING=true                 # skip artists already in Plex
MAX_NEW_PER_RUN=0                  # 0 = unlimited; e.g. 20 to pace downloads
SCHEDULE=0 3 * * *                 # cron syntax (UTC); default = 3am daily
SEEN_DB=/data/seen_artists.json    # persists what's been queued

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # INFO | DEBUG
